<Window x:Class="OptiSync.UI.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiSync.NP – Koordynator optymalizacji TSP"
        Width="1400" Height="860" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Gotowy. Wybierz plik .tsp i kliknij Start." />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ProcessText" Foreground="#666" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>
                    <GroupBox Header="Dane wejściowe">
                        <StackPanel>
                            <TextBlock Style="{StaticResource LabelText}" Text="Plik instancji (TSPLIB, EUC_2D)" />
                            <DockPanel>
                                <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Wybierz…" MinWidth="0" Margin="6,0,0,0" Click="BrowseButton_Click" />
                                <TextBox x:Name="FilePathBox" IsReadOnly="True" VerticalContentAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="InstanceInfoText" Foreground="#666" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Konfiguracja silnika">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource LabelText}" Text="Silnik wykonawczy" />
                            <ComboBox x:Name="EngineCombo" Grid.Row="1" Grid.ColumnSpan="2" SelectedIndex="0" Margin="0,0,0,6">
                                <ComboBoxItem Content="TPL Worker Process" />
                                <ComboBoxItem Content="Thread Queue Worker Process" />
                            </ComboBox>

                            <TextBlock Grid.Row="2" Text="Liczba wątków / zadań N" VerticalAlignment="Center" />
                            <TextBox x:Name="WorkerCountBox" Grid.Row="2" Grid.Column="1" Text="8" Margin="0,2" />

                            <TextBlock Grid.Row="3" Text="Liczba epok" VerticalAlignment="Center" />
                            <TextBox x:Name="EpochsBox" Grid.Row="3" Grid.Column="1" Text="20" Margin="0,2" />

                            <TextBlock Grid.Row="4" Text="Czas Fazy 1 [s]" VerticalAlignment="Center" />
                            <TextBox x:Name="Phase1Box" Grid.Row="4" Grid.Column="1" Text="5" Margin="0,2" TextChanged="PhaseTimeBox_TextChanged" />

                            <TextBlock Grid.Row="5" Text="Czas Fazy 2 [s]" VerticalAlignment="Center" />
                            <TextBox x:Name="Phase2Box" Grid.Row="5" Grid.Column="1" Text="5" Margin="0,2" TextChanged="PhaseTimeBox_TextChanged" />

                            <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Czasy faz można zmieniać w trakcie obliczeń – obowiązują od startu kolejnej tury." />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Sterowanie">
                        <WrapPanel>
                            <Button x:Name="StartButton" Content="Start" Click="StartButton_Click" />
                            <Button x:Name="PauseButton" Content="Pause" IsEnabled="False" Click="PauseButton_Click" />
                            <Button x:Name="StopButton" Content="Stop" IsEnabled="False" Click="StopButton_Click" />
                            <Button x:Name="ExitButton" Content="Exit" Click="ExitButton_Click" />
                        </WrapPanel>
                    </GroupBox>

                    <GroupBox Header="Heurystyka Roslyn (C# Scripting)">
                        <StackPanel>
                            <CheckBox x:Name="UseScriptCheck" Content="Użyj własnego operatora mutacji" Margin="0,0,0,4" />
                            <TextBlock Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Text="Wyrażenie typu Action&lt;int[], Random&gt; modyfikujące trasę w miejscu. Kompilowane przez CSharpScript.Create przed startem i wykonywane przez wątki robocze w Fazie 1." />
                            <TextBox x:Name="ScriptBox" FontFamily="Consolas" FontSize="12" Height="150" AcceptsReturn="True" AcceptsTab="True"
                                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                            <Button x:Name="CompileButton" Content="Kompiluj" HorizontalAlignment="Left" Margin="0,6,0,0" Click="CompileButton_Click" />
                            <TextBlock x:Name="ScriptStatusText" TextWrapping="Wrap" Foreground="#666" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock x:Name="PhaseHeadline" FontSize="18" FontWeight="SemiBold" Text="Brak aktywnych obliczeń" />
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock x:Name="ProgressText" DockPanel.Dock="Right" Margin="8,0,0,0" Width="90" TextAlignment="Right" />
                        <ProgressBar x:Name="EpochProgress" Height="16" Minimum="0" Maximum="1" />
                    </DockPanel>
                </StackPanel>
                <Border Grid.Row="1" BorderBrush="#BBB" BorderThickness="1" Background="#FBFBFD">
                    <Canvas x:Name="MapCanvas" ClipToBounds="True" SizeChanged="MapCanvas_SizeChanged" />
                </Border>
            </Grid>

            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Monitor rywalizacji wątków">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Style="{StaticResource LabelText}" Text="Best Result" />
                            <TextBlock x:Name="BestResultText" Style="{StaticResource StatValue}" Text="–" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Style="{StaticResource LabelText}" Text="Leader Thread" />
                            <TextBlock x:Name="LeaderText" Style="{StaticResource StatValue}" Text="–" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Style="{StaticResource LabelText}" Text="Solution Count" />
                            <TextBlock x:Name="SolutionCountText" Style="{StaticResource StatValue}" Text="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Style="{StaticResource LabelText}" Text="Rozwiązań / s (średnio | chwilowo)" />
                            <TextBlock x:Name="ThroughputText" Style="{StaticResource StatValue}" Text="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Style="{StaticResource LabelText}" Text="Epoka" />
                            <TextBlock x:Name="EpochText" Style="{StaticResource StatValue}" Text="–" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Style="{StaticResource LabelText}" Text="Pozostały czas fazy" />
                            <TextBlock x:Name="PhaseRemainingText" Style="{StaticResource StatValue}" Text="–" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0">
                            <TextBlock Style="{StaticResource LabelText}" Text="Silnik" />
                            <TextBlock x:Name="EngineText" Style="{StaticResource StatValue}" FontSize="12" TextWrapping="Wrap" Text="–" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1">
                            <TextBlock Style="{StaticResource LabelText}" Text="Czas obliczeń" />
                            <TextBlock x:Name="ElapsedText" Style="{StaticResource StatValue}" Text="–" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <TabControl Grid.Row="1">
                    <TabItem Header="Wątki">
                        <DataGrid x:Name="WorkerGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  CanUserSortColumns="False" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Worker" Binding="{Binding WorkerLabel}" Width="70" />
                                <DataGridTextColumn Header="Wątek OS" Binding="{Binding ManagedThreadId}" Width="65" />
                                <DataGridTextColumn Header="Iteracje" Binding="{Binding Iterations, StringFormat=N0}" Width="*" />
                                <DataGridTextColumn Header="Rekordy" Binding="{Binding RecordsSet}" Width="60" />
                                <DataGridTextColumn Header="Najlepszy" Binding="{Binding BestCost, StringFormat=F1}" Width="75" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Optimal Tour">
                        <DataGrid x:Name="TourGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  CanUserSortColumns="False" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="40" />
                                <DataGridTextColumn Header="Miasto" Binding="{Binding CityId}" Width="60" />
                                <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=F2}" Width="*" />
                                <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=F2}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Dziennik">
                        <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="11" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
